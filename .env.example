# PostgreSQL connection string
DATABASE_URL="postgresql://bloodlink:bloodlink@localhost:5433/bloodlink"

# Long random string used to sign session cookies (openssl rand -base64 48)
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL, used in SMS/email links and the QR code
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated emails that get access to /admin (sign in via Organisation login)
ADMIN_EMAILS="admin@example.com"

# OTP delivery. "console" logs codes to the server output (development only).
# "twilio" sends SMS via Twilio; email OTPs use SMTP when SMTP_HOST is set.
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="BloodLink <no-reply@example.com>"

# When "true", the OTP is returned in the API response and shown on screen.
# Never enable this in production.
DEV_SHOW_OTP="true"

# Protects /api/cron/expand-requests (send as Authorization: Bearer <secret>)
CRON_SECRET="change-me"

# Demo mode: shows a banner (some figures are simulated) and one-click demo sign-in buttons.
# Leave "false" in production.
NEXT_PUBLIC_DEMO_MODE="false"
